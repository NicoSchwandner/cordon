# Cordon environment variables
# Copy to .env and fill in real values: cp .env.example .env

# GitHub personal access token (fine-grained)
# Required scopes: Contents (read/write), Metadata (read)
# Used for: cloning private repos, git push from workspaces, gh CLI
GITHUB_TOKEN=

# Authentication mode: "static" (dev), "token" (API key), "jwt" (production)
# AUTH_MODE=jwt
# CORDON_INSECURE=true              # Required for AUTH_MODE=static (safety guard)

# JWT auth (required when AUTH_MODE=jwt)
# Point JWKS URL at your IdP: Entra ID, Auth0, Cognito, Keycloak, etc.
# CORDON_JWT_JWKS_URL=https://login.microsoftonline.com/{tenant}/discovery/v2.0/keys
# CORDON_JWT_AUDIENCE=api://cordon
# CORDON_JWT_TENANT_CLAIM=tid       # Default: "tenant_id". Entra ID uses "tid".
